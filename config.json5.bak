// DocuLight Test Configuration
{
  docsRoot: "./test-source",
  apiKey: "test-key-12345",
  maxUploadMB: 10,
  port: 3000,
  ui: {
    title: "DOCU LIGHT",
    icon: "./public/images/icon.png",  // Optional: defaults to ./public/images/icon.png if not specified
    maxWidth: "1224px"  // Final test - back to default
  },
  excludes: [
    "**/.git/",
    "**/.DS_Store",
    "**/node_modules/"
  ],
  logDir: "./logs",
  logLevel: "info",

  // SSL/TLS configuration
  ssl: {
    enabled: false,
    cert: "/tmp/DocuLight-cert.pem",
    key: "/tmp/DocuLight-key.pem"
  }
,
  // Hot-reload options
  hotReload: {
    // When true, watcher will attempt automatic restart even when port/SSL changed.
    // Use with caution in production; default is false.
    allowPortSslAutoRestart: true
  }

  // Note: cache settings are optional - defaults will be used if not specified:
  // cache.enabled: true
  // cache.scanThrottle: 500 (ms)
  // cache.maxMemorySize: 100 (MB)
  // cache.maxDiskSize: 500 (MB)
  // cache.preRenderOnStartup: true
  // cache.mermaidSSR: false
  // cache.cacheDir: "./.cache"
  // cache.compressionLevel: 0
  // cache.cleanupAfterDays: 30
}
