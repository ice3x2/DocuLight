{
  "name": "@doculight/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DocuLight 2.0 프론트엔드 — Vite + React + TypeScript SPA (CON-ARCH-003). SSR 계층을 두지 않는다",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser:focus": "node test/focus-retention-check.mjs",
    "test:browser:focus:headed": "node test/focus-retention-check.mjs --headed",
    "test:browser:all": "npm run test:browser:focus && npm run test:browser:ime && npm run test:browser:search && npm run test:browser:merge && npm run test:browser:styles && npm run test:browser:acl && npm run test:browser:trash",
    "test:browser:ime": "node test/ime-composition-check.mjs",
    "test:browser:ime:headed": "node test/ime-composition-check.mjs --headed",
    "test:browser:search": "node test/search-layout-check.mjs",
    "test:browser:search:headed": "node test/search-layout-check.mjs --headed",
    "test:browser:merge": "node test/merge-view-check.mjs",
    "test:browser:merge:headed": "node test/merge-view-check.mjs --headed",
    "test:browser:styles": "node test/editor-styles-check.mjs",
    "test:browser:styles:headed": "node test/editor-styles-check.mjs --headed",
    "test:browser:acl": "node test/acl-two-account-check.mjs",
    "test:browser:acl:headed": "node test/acl-two-account-check.mjs --headed",
    "test:browser:trash": "node test/trash-round-trip-check.mjs",
    "test:browser:trash:headed": "node test/trash-round-trip-check.mjs --headed"
  },
  "dependencies": {
    "@codemirror/merge": "^6.10.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@doculight/editor": "*",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "cmdk": "^1.1.1",
    "react": "^19.2.7",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  }
}
